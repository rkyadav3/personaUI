# Server-side (Vercel -> Project -> Settings -> Environment Variables, or .env.local for `vercel dev`). Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your secret / service_role key
GEMINI_API_KEY=your Google AI Studio key
SESSION_SECRET=a long random string (32+ chars) used to sign login cookies
# Check the current model id in Google AI Studio and set it here if the default stops working:
GEMINI_MODEL=gemini-3.5-flash-lite
# Relevance gates (tune with Admin -> Knowledge index -> Test retrieval)
MIN_SIMILARITY=0.6
MIN_KEYWORD_RANK=0.2

# Accounts
REGISTRATION_MODE=invite        # invite = private platform (needs a code from Admin -> Invites) | open | closed
SITE_NAME=Persona               # shown in the home page header
ADMIN_EMAILS=you@example.com    # comma separated; admins see the Invites page
DEFAULT_SLUG=                   # optional: only used by /api/chat and /api/site when no slug is sent. The root page "/" is now the members' home

# Optional
# EMBED_MODEL=gemini-embedding-001
# EMBED_TPM=24000               # free tier allows 30,000 tokens/minute; stay under it

# Browser-side (public by design). Used only so uploads can go straight to Supabase Storage.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your publishable / anon key
