<%- include('../partials/admin-head') %>
<div class="bar"><h1>Writing</h1><a class="btn primary" href="/admin/posts/new">New post</a></div>
<table class="table"><thead><tr><th>Title</th><th>Topic</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
<% posts.forEach(p => { %>
  <tr><td><a class="strong" href="/admin/posts/<%= p.id %>"><%= p.title %></a></td><td><%= p.topic || '' %></td>
  <td><span class="pill <%= p.status %>"><%= p.status %></span></td><td><%= p.updated_at %></td>
  <td class="acts"><form method="post" action="/admin/posts/<%= p.id %>/delete" onsubmit="return confirm('Delete this post?')"><button class="link danger">Delete</button></form></td></tr>
<% }) %>
<% if (!posts.length) { %><tr><td colspan="5" class="muted">No posts yet. Write your first one.</td></tr><% } %>
</tbody></table>
<%- include('../partials/admin-foot') %>
