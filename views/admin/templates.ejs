<%- include('../partials/admin-head') %>
<h1>Templates</h1>
<p class="muted">Templates are starting layouts for new posts. Write HTML, then start a post from it.</p>
<div class="row">
  <form class="card" method="post" action="/admin/templates"><h2>New template</h2>
    <label>Name<input name="name" required></label>
    <label>HTML<textarea class="code" name="html" rows="8"></textarea></label>
    <button class="btn primary">Save template</button></form>
  <div class="card grow"><h2>Your templates</h2>
    <% templates.forEach(t => { %>
      <details><summary><b><%= t.name %></b></summary>
        <form method="post" action="/admin/templates"><input type="hidden" name="id" value="<%= t.id %>">
          <label>Name<input name="name" value="<%= t.name %>"></label>
          <label>HTML<textarea class="code" name="html" rows="6"><%= t.html %></textarea></label>
          <button class="btn">Update</button> <a class="btn" href="/admin/posts/new?template=<%= t.id %>">Start a post</a>
        </form>
        <form method="post" action="/admin/templates/<%= t.id %>/delete"><button class="link danger">Delete</button></form>
      </details>
    <% }) %></div>
</div>
<%- include('../partials/admin-foot') %>
