<%- include('../partials/admin-head') %>
<div class="bar"><h1>Add files</h1><a class="btn" href="/admin/files<%= folderId ? '?folder=' + folderId : '' %>">Go to file manager</a></div>
<p class="muted">Add new material here. To browse, rename, move or delete files, use the file manager.</p>

<%
  const folderSelect = name => `<select name="${name}"><option value="">Top level</option>` +
    folders.map(f => `<option value="${f.id}" ${f.id === folderId ? 'selected' : ''}>${f.path.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</option>`).join('') + '</select>';
%>

<div class="row">
  <form class="card grow" id="uploadForm" method="post" action="/admin/files/upload" enctype="multipart/form-data">
    <h2>Upload files, a folder or a zip</h2>
    <div id="drop" class="drop">Drop files or folders here</div>
    <div class="btns">
      <label class="btn">Choose files<input type="file" id="pickFiles" multiple hidden></label>
      <label class="btn">Choose folder<input type="file" id="pickFolder" webkitdirectory hidden></label>
      <label class="btn">Choose zip<input type="file" id="pickZip" accept=".zip" hidden></label>
    </div>
    <label class="check"><input type="checkbox" name="unzip" checked> Unzip zip files into folders</label>
    <label>Save into folder <%- folderSelect('folder') %></label>
    <label>Research topic
      <select name="topic_id"><option value="">None</option>
        <% topics.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label>
    <p id="queue" class="muted">No files chosen.</p>
    <button class="btn primary" id="send" disabled>Upload</button>
  </form>

  <form class="card grow" method="post" action="/admin/files/create">
    <h2>Create a new text file</h2>
    <label>File name <input name="name" placeholder="e.g. notes-on-method" required></label>
    <label>Type
      <select name="ext"><option value="md">Markdown (.md)</option><option value="txt">Plain text (.txt)</option>
        <option value="html">HTML (.html)</option><option value="csv">CSV (.csv)</option><option value="json">JSON (.json)</option></select></label>
    <label>Save into folder <%- folderSelect('folder') %></label>
    <label>Research topic
      <select name="topic_id"><option value="">None</option>
        <% topics.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label>
    <label>Content <textarea class="code" name="text" rows="8" style="min-height:0"></textarea></label>
    <div class="btns">
      <button class="btn" name="status" value="draft">Save as draft</button>
      <button class="btn primary" name="status" value="published">Create and publish</button>
    </div>
    <p class="muted">Drafts stay private. Only published files feed the persona.</p>
  </form>

  <form class="card" method="post" action="/admin/folders">
    <h2>New folder</h2>
    <label>Name <input name="name" required></label>
    <label>Inside <%- folderSelect('folder') %></label>
    <button class="btn">Create folder</button>
  </form>
</div>
<script src="/js/uploader.js"></script>
<%- include('../partials/admin-foot') %>
