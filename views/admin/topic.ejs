<%- include('../partials/admin-head') %>
<nav class="crumbs"><a href="/admin/topics">Research topics</a> / <%= topic.name %></nav>
<div class="row">
  <form class="card" method="post" action="/admin/topics/<%= topic.id %>"><h2>Details</h2>
    <label>Name<input name="name" value="<%= topic.name %>" required></label>
    <label>Description<textarea name="description" rows="4"><%= topic.description %></textarea></label>
    <button class="btn primary">Save</button></form>
  <div class="card grow"><h2>Files</h2>
    <% if (!files.length) { %><p class="muted">No files yet. Assign this topic when uploading, or from a file's page.</p><% } %>
    <ul class="plain"><% files.forEach(f => { %><li><a href="/admin/files/<%= f.id %>"><%= f.name %></a></li><% }) %></ul>
    <h2>Writing</h2>
    <ul class="plain"><% posts.forEach(p => { %><li><a href="/admin/posts/<%= p.id %>"><%= p.title %></a> <span class="pill <%= p.status %>"><%= p.status %></span></li><% }) %></ul>
    <a class="btn" href="/admin/posts/new?topic=<%= topic.id %>">New post in this topic</a>
    <form method="post" action="/admin/topics/<%= topic.id %>/delete" onsubmit="return confirm('Delete topic? Files and posts are kept.')" style="margin-top:12px"><button class="link danger">Delete topic</button></form>
  </div>
</div>
<%- include('../partials/admin-foot') %>
