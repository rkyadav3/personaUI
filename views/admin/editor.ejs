<%- include('../partials/admin-head') %>
<div class="bar">
  <h1><input id="title" class="title" value="<%= post.title %>" placeholder="Title"></h1>
  <div class="btns">
    <select id="topic"><option value="">No topic</option>
      <% topics.forEach(t => { %><option value="<%= t.id %>" <%= t.id === post.topic_id ? 'selected' : '' %>><%= t.name %></option><% }) %></select>
    <button class="btn" id="draft">Save as draft</button>
    <button class="btn primary" id="publish">Publish</button>
    <span id="state" class="muted"><%= post.status === 'published' ? 'Published' : 'Draft' %></span>
  </div>
</div>

<div class="toolbar" id="toolbar">
  <select data-cmd="formatBlock" title="Paragraph style">
    <option value="p">Paragraph</option><option value="h1">Heading 1</option><option value="h2">Heading 2</option>
    <option value="h3">Heading 3</option><option value="blockquote">Quote</option><option value="pre">Code block</option></select>
  <select data-cmd="fontName" title="Font">
    <option value="">Font</option><option>Newsreader</option><option>Figtree</option><option>Georgia</option><option>Courier New</option></select>
  <select data-cmd="fontSize" title="Size">
    <option value="">Size</option><option value="2">Small</option><option value="3">Normal</option><option value="5">Large</option><option value="6">Huge</option></select>
  <span class="sep"></span>
  <button data-cmd="bold"><b>B</b></button><button data-cmd="italic"><i>I</i></button>
  <button data-cmd="underline"><u>U</u></button><button data-cmd="strikeThrough"><s>S</s></button>
  <label class="tool" title="Text colour">A<input type="color" data-cmd="foreColor" value="#1b2a2f"></label>
  <label class="tool" title="Highlight">H<input type="color" data-cmd="hiliteColor" value="#fff3a3"></label>
  <span class="sep"></span>
  <button data-cmd="insertUnorderedList">Bullets</button><button data-cmd="insertOrderedList">Numbers</button>
  <button data-cmd="justifyLeft">Left</button><button data-cmd="justifyCenter">Centre</button><button data-cmd="justifyRight">Right</button>
  <span class="sep"></span>
  <button id="link">Link</button><button id="image">Image</button><button id="table">Table</button><button data-cmd="insertHorizontalRule">Rule</button>
  <span class="sep"></span>
  <button data-cmd="undo">Undo</button><button data-cmd="redo">Redo</button><button data-cmd="removeFormat">Clear</button>
  <button id="source">HTML</button>
</div>
<div id="page" class="page" contenteditable="true"><%- post.html %></div>
<textarea id="src" class="code" hidden></textarea>

<script>
const postId = <%= post.id %>;
</script>
<script src="/js/editor.js"></script>
<%- include('../partials/admin-foot') %>
