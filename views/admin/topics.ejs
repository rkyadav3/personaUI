<%- include('../partials/admin-head') %>
<h1>Research topics</h1>
<div class="row">
  <form class="card" method="post" action="/admin/topics"><h2>New topic</h2>
    <label>Name<input name="name" required></label>
    <label>What is it about?<textarea name="description" rows="3"></textarea></label>
    <button class="btn primary">Create topic</button></form>
  <div class="card grow"><h2>All topics</h2>
    <% if (!topics.length) { %><p class="muted">No topics yet. Create one, then attach files and posts to it.</p><% } %>
    <ul class="plain"><% topics.forEach(t => { %>
      <li><a class="strong" href="/admin/topics/<%= t.id %>"><%= t.name %></a> <span class="muted"><%= t.file_count %> files, <%= t.post_count %> posts</span></li>
    <% }) %></ul></div>
</div>
<%- include('../partials/admin-foot') %>
