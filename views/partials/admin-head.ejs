<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700&family=Newsreader:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head><body>
<aside class="side">
  <a class="brand" href="/admin">Studio</a>
  <nav>
    <% [['dashboard','Overview','/admin'],['files','File manager','/admin/files'],['filesnew','Add files','/admin/files/new'],['topics','Research topics','/admin/topics'],['posts','Writing','/admin/posts'],['templates','Templates','/admin/templates']].forEach(n => { %>
      <a href="<%= n[2] %>" class="<%= nav === n[0] ? 'on' : '' %>"><%= n[1] %></a>
    <% }) %>
  </nav>
  <div class="side-foot">
    <a href="/" target="_blank">View site</a>
    <form method="post" action="/admin/logout"><button class="link">Sign out</button></form>
  </div>
</aside>
